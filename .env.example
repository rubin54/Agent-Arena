# Copy this file to backend/.env and fill in your key.

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional; shows up in the OpenRouter rankings
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Agent Arena

# Postgres (must match docker-compose.yml)
DATABASE_URL=postgresql+asyncpg://arena:arena@localhost:5433/arena

# How many models of a run are queried in parallel
RUN_CONCURRENCY=6
# Agent runs spin up a container each, so they run less broadly in parallel
AGENT_CONCURRENCY=3
# Sandbox image; built automatically on the first agent run
SANDBOX_IMAGE=agent-arena-sandbox:latest
# Timeout per model request, in seconds
REQUEST_TIMEOUT_S=300
# How long the model catalog is cached before it is refreshed automatically
CATALOG_TTL_MINUTES=60

# Comma-separated
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
