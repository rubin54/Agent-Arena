# Kopiere diese Datei nach backend/.env und trage deinen Key ein.

# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional, taucht in den OpenRouter-Rankings auf
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=Agent Arena

# Postgres (muss zum docker-compose.yml passen)
DATABASE_URL=postgresql+asyncpg://arena:arena@localhost:5433/arena

# Wie viele Modelle eines Runs parallel angefragt werden
RUN_CONCURRENCY=6
# Timeout pro Modell-Request in Sekunden
REQUEST_TIMEOUT_S=300
# Wie lange der Modell-Katalog gecacht wird, bevor automatisch neu geladen wird
CATALOG_TTL_MINUTES=60

# Komma-separiert
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
